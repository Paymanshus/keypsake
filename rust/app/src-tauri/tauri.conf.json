{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keypsake",
  "version": "0.1.0",
  "identifier": "com.keypsake.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "keypsake",
    "copyright": "Apache License 2.0",
    "category": "Productivity",
    "shortDescription": "Everything you type, kept.",
    "longDescription": "keypsake quietly saves what you type into any text box, in any app, plus a short clipboard history. Encrypted, stays on this PC.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
